# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System/tool files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.vs
*.suo
*.user

# Build outputs
build/
dist/
exports/
*.exe
*.app
*.apk
*.ipa

# Logs
*.log
logs/

# Local config (contains secrets, API keys)
config/local.cfg
config/secrets.cfg
.env
.env.local

# SDK dependencies (pulled via package manager or build script)
addons/
/sdk/

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Test coverage
coverage/
.coverage
htmlcov/

# OS
$RECYCLE.BIN/
System Volume Information/

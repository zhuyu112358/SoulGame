; Engine configuration file.
; SoulGame - AI Soul Game Application
; Godot 4.x project configuration

config_version=5

[application]

config/name="SoulGame"
config/description="AI Soul Game - A game where AI souls live, grow, and battle"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Logger="*res://scripts/autoload/Logger.gd"
EventBus="*res://scripts/autoload/EventBus.gd"
ConfigManager="*res://scripts/autoload/ConfigManager.gd"
GameState="*res://scripts/autoload/GameState.gd"
SceneManager="*res://scripts/autoload/SceneManager.gd"
SaveSystem="*res://scripts/autoload/SaveSystem.gd"
NetworkClient="*res://scripts/core/NetworkClient.gd"
SoulArenaClient="*res://scripts/sdk/SoulArenaClient.gd"
SeedClient="*res://scripts/sdk/SeedClient.gd"
DebugOverlay="*res://scripts/core/DebugOverlay.gd"
PerformanceMonitor="*res://scripts/core/PerformanceMonitor.gd"
StateSyncClient="*res://scripts/core/StateSyncClient.gd"
LatencyProfiler="*res://scripts/core/LatencyProfiler.gd"
ObjectPool="*res://scripts/core/ObjectPool.gd"
ResourceManager="*res://scripts/core/ResourceManager.gd"
InputManager="*res://scripts/core/InputManager.gd"
ErrorHandler="*res://scripts/core/ErrorHandler.gd"
TimeManager="*res://scripts/core/TimeManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
LocalizationManager="*res://scripts/core/LocalizationManager.gd"
AnimationManager="*res://scripts/core/AnimationManager.gd"
SoulManager="*res://scripts/game/SoulManager.gd"
WorldManager="*res://scripts/game/WorldManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/vsync/vsync_mode=1
window/permissions/internet_access=true

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":27,"location":0,"echo":false,"script":null)
]
}
toggle_debug={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":96,"key_label":0,"unicode":96,"location":0,"echo":false,"script":null)
]
}

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="soul"
2d_physics/layer_3="interactable"
2d_physics/layer_4="ui"

[physics]

common/physics_ticks_per_second=60
common/physics_jitter_fix=0.5
2d/use_continuous_collision_detection=false
2d/default_gravity=980.0
2d/default_gravity_vector=Vector2(0, 1)

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"
driver/mix_rate=44100
driver/output_latency=0.05

[debug]

settings/fps/force_fps=0
settings/print_to_console=true
settings/stdout/verbose_stdout=false
gdscript/warnings/untyped_declaration=1
gdscript/warnings/integer_division=1
gdscript/warnings/unsafe_call=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/native_method_override=1
gdscript/completion/add_type_hints=true
gdscript/places_capitalization=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.08, 1)
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_rotation_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false
2d/options/use_pixel_snap=false
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/use_debanding=false
lights_and_shadows/2d/use_shadow_texture=true
lights_and_shadows/2d/shadow_texture_size=2048
lights_and_shadows/2d/shadow_atlas_size=2048
lights_and_shadows/2d/directional_shadow_mode=1
particles/use_gpu_sim=true
limits/buffers/lightmap_capture_pool_size=256
limits/buffers/particles_pool_size=2048
limits/buffers/particles_emitter_pool_size=256
limits/buffers/particles_draw_list_size=2048
limits/buffers/2d/vertices=4096
limits/buffers/2d/indices=8192
debug/draw_fps=false
debug/draw_time_discrete=false
debug/viewport/debug_compat=false
